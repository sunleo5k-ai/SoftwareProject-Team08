# Copy to .env (or set these in your shell) to change the defaults.

# Database: SQLite file by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://smartpark:smartpark@localhost:5432/smartpark
# DATABASE_URL=sqlite:///data/smartpark.db

# Demo mode shows the OTP on screen (no real SMS gateway) and enables the
# "Demo Tools" page that moves the system clock for the live demonstration.
DEMO_MODE=true

# Key that the (simulated) ANPR cameras, QR readers and occupancy sensors send.
DEVICE_KEY=demo-device-key

# Sessions expire after this many idle minutes (NFR-09).
SESSION_IDLE_MINUTES=15

# How often the scheduler runs (hold expiry, no-show release, reminders, data purge).
JOB_INTERVAL_SECONDS=30
